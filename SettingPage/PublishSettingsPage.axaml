<ci:SettingsPageBase x:Class="NtpServer.PublishSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:vm="clr-namespace:NtpServer.ViewModels"
                     mc:Ignorable="d"
                     d:DesignHeight="500"
                     d:DesignWidth="800">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Spacing="4">

            <controls:InfoBar Severity="Informational"
                              IsClosable="False"
                              IsOpen="True"
                              Message="在此页面把本机时间作为「时间源」发布到局域网。同步端会自动发现本机并请求时间。" />

            <controls:InfoBar Severity="Error"
                              Message="{Binding ViewModel.LastError}"
                              IsClosable="False"
                              IsOpen="{Binding !!ViewModel.LastError}" />

            <controls:InfoBar Severity="Success"
                              Message="{Binding ViewModel.StatusText}"
                              IsClosable="False"
                              IsOpen="{Binding ViewModel.IsRunning}" />

            <!-- ===== 发布设置 ===== -->
            <ci:IconText Glyph="&#xE724;" Text="发布设置" Margin="0 8 0 4" />
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE715;}"
                                       Header="发布设置"
                                       IsExpanded="True">
                <controls:SettingsExpanderItem Content="设备名"
                                               Description="同步端据此识别你的机器（可使用中文，例如「教室1-主控」）">
                    <controls:SettingsExpanderItem.Footer>
                        <TextBox Text="{Binding ViewModel.Settings.DeviceName, Mode=TwoWay}" Width="220" />
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
                <controls:SettingsExpanderItem Content="HTTP 端口"
                                               Description="同步端访问的端口（默认 12345）">
                    <controls:SettingsExpanderItem.Footer>
                        <NumericUpDown Value="{Binding ViewModel.Settings.Port, Mode=TwoWay}"
                                       Minimum="1024"
                                       Maximum="65535"
                                       Width="120" />
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
                <controls:SettingsExpanderItem Content="自动启动"
                                               Description="ClassIsland 启动时自动开启发布服务">
                    <controls:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.Settings.AutoStart, Mode=TwoWay}" />
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
            </controls:SettingsExpander>

            <!-- ===== 服务控制 ===== -->
            <ci:IconText Glyph="&#xE713;" Text="服务控制" Margin="0 8 0 4" />
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE713;}"
                                       Header="服务控制"
                                       IsExpanded="True">
                <controls:SettingsExpanderItem Content="开始发布"
                                               Description="开始向局域网发布本机时间"
                                               IsClickEnabled="True"
                                               ActionIconSource="{ci:FluentIconSource &#xE768;}"
                                               Click="ButtonStartPublish_OnClick" />
                <controls:SettingsExpanderItem Content="停止发布"
                                               Description="停止向局域网发布"
                                               IsClickEnabled="True"
                                               ActionIconSource="{ci:FluentIconSource &#xE71A;}"
                                               Click="ButtonStopPublish_OnClick" />
            </controls:SettingsExpander>

            <!-- ===== 状态 ===== -->
            <ci:IconText Glyph="&#xE625;" Text="状态" Margin="0 8 0 4" />
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE895;}"
                                       Header="本机 IP"
                                       IsExpanded="True"
                                       Description="同步端可用的访问地址">
                <controls:SettingsExpanderItem Content="已响应请求数">
                    <controls:SettingsExpanderItem.Footer>
                        <TextBlock Text="{Binding ViewModel.RequestCount}" VerticalAlignment="Center" />
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
                <ItemsControl ItemsSource="{Binding ViewModel.LocalIps}"
                              IsVisible="{Binding !!ViewModel.LocalIps.Count}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SettingsExpanderItem Content="{Binding}">
                                <controls:SettingsExpanderItem.Footer>
                                    <Button Theme="{StaticResource TransparentButton}"
                                            Content="{ci:FluentIcon &#xE8C8;}"
                                            ToolTip.Tip="复制完整同步 URL"
                                            Click="ButtonCopyUrl_OnClick"
                                            Tag="{Binding}" />
                                </controls:SettingsExpanderItem.Footer>
                            </controls:SettingsExpanderItem>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0 4 0 0"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !ViewModel.LocalIps.Count}"
                           Text="暂无可用 IPv4 地址。" />
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
