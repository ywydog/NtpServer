<ci:SettingsPageBase x:Class="NtpServer.SyncSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:vm="clr-namespace:NtpServer.ViewModels"
                     mc:Ignorable="d"
                     d:DesignHeight="600"
                     d:DesignWidth="800">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Spacing="4">

            <controls:InfoBar Severity="Informational"
                              IsClosable="False"
                              IsOpen="True"
                              Message="在下方填入发布端的「设备名」或「IP」，点击「立即同步」即可让本机时间与发布端对齐。设备名可在「设备发现」中自动选择。" />

            <controls:InfoBar Severity="Error"
                              Message="{Binding ViewModel.LastError}"
                              IsClosable="False"
                              IsOpen="{Binding !!ViewModel.LastError}" />

            <controls:InfoBar Severity="Success"
                              Message="{Binding ViewModel.StatusText}"
                              IsClosable="False"
                              IsOpen="{Binding !!ViewModel.LastSyncedTime}" />

            <!-- ===== 设备发现 ===== -->
            <ci:IconText Glyph="&#xE72E;" Text="设备发现" Margin="0 8 0 4" />
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE72E;}"
                                       Header="设备发现"
                                       IsExpanded="True"
                                       Description="订阅组播 239.255.42.42，列出本局域网中所有「时间发布」端。">
                <controls:SettingsExpanderItem Content="发现状态"
                                               Description="{Binding ViewModel.StatusText}">
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="启动发现" Classes="accent" Click="ButtonStartDiscovery_OnClick" />
                            <Button Content="停止发现" Click="ButtonStopDiscovery_OnClick" />
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <ItemsControl ItemsSource="{Binding ViewModel.DiscoveredDevices}"
                              IsVisible="{Binding !!ViewModel.DiscoveredDevices.Count}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SettingsExpanderItem>
                                <controls:SettingsExpanderItem.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Ip}" Opacity="0.7" />
                                    </StackPanel>
                                </controls:SettingsExpanderItem.Content>
                                <controls:SettingsExpanderItem.Description>
                                    <Binding Path="LastSeen" StringFormat="最近发布：{0:HH:mm:ss}" />
                                </controls:SettingsExpanderItem.Description>
                                <controls:SettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="使用此设备"
                                                Click="ButtonUseDevice_OnClick"
                                                Tag="{Binding}" />
                                    </StackPanel>
                                </controls:SettingsExpanderItem.Footer>
                            </controls:SettingsExpanderItem>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0 4 0 0"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !ViewModel.DiscoveredDevices.Count}"
                           Text="暂未发现发布端。请确认目标机器已打开「时间发布」页。" />
            </controls:SettingsExpander>

            <!-- ===== 同步目标 ===== -->
            <ci:IconText Glyph="&#xE71B;" Text="同步目标" Margin="0 8 0 4" />
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE71B;}"
                                       Header="同步目标"
                                       IsExpanded="True">
                <controls:SettingsExpanderItem Content="设备名"
                                               Description="在「设备发现」中点选，或直接手动输入">
                    <controls:SettingsExpanderItem.Footer>
                        <TextBox Text="{Binding ViewModel.Settings.TargetDeviceName, Mode=TwoWay}" Width="220" />
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
                <controls:SettingsExpanderItem Content="手动 IP（可选）"
                                               Description="如不通过设备名自动解析，可直接指定 IP+端口">
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding ViewModel.Settings.TargetIp, Mode=TwoWay}"
                                     Watermark="如 192.168.1.5"
                                     Width="160" />
                            <NumericUpDown Value="{Binding ViewModel.Settings.Port, Mode=TwoWay}"
                                           Minimum="1024"
                                           Maximum="65535"
                                           Width="120" />
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
                <controls:SettingsExpanderItem Content="时间调整方式"
                                               Description="软调整：仅在 ClassIsland 内部偏移显示时间（无需管理员）。硬调整：直接改 Windows 系统时间（需管理员）。">
                    <controls:SettingsExpanderItem.Footer>
                        <ComboBox SelectedIndex="{Binding ViewModel.Settings.ApplyMode, Mode=TwoWay}"
                                  Width="220">
                            <ComboBoxItem Content="软调整（推荐）" />
                            <ComboBoxItem Content="硬调整（改系统时间）" />
                        </ComboBox>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
            </controls:SettingsExpander>

            <!-- ===== 同步操作 ===== -->
            <ci:IconText Glyph="&#xE895;" Text="同步操作" Margin="0 8 0 4" />
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE895;}"
                                       Header="同步操作"
                                       IsExpanded="True">
                <controls:SettingsExpanderItem Content="立即同步"
                                               Description="向目标发起一次时间请求"
                                               IsClickEnabled="True"
                                               ActionIconSource="{ci:FluentIconSource &#xE895;}"
                                               Click="ButtonSyncNow_OnClick" />
                <controls:SettingsExpanderItem Content="目标地址">
                    <controls:SettingsExpanderItem.Footer>
                        <TextBlock Text="{Binding ViewModel.ResolvedEndpoint}" Opacity="0.7" />
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
                <controls:SettingsExpanderItem Content="最近同步"
                                               Description="{Binding ViewModel.LastSyncedTime, StringFormat='时间：{0:yyyy-MM-dd HH:mm:ss}'}"
                                               IsVisible="{Binding !!ViewModel.LastSyncedTime}">
                    <controls:SettingsExpanderItem.Footer>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="时差：" />
                            <Run Text="{Binding ViewModel.DeltaSeconds, StringFormat='{}{0:F2} 秒'}" />
                        </TextBlock>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
